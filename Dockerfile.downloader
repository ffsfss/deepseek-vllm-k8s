FROM python:3.12.16-slim-bookworm

ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/app/.cache/huggingface

RUN groupadd \
        --gid "${APP_GID}" \
        app \
    && useradd \
        --uid "${APP_UID}" \
        --gid "${APP_GID}" \
        --create-home \
        --home-dir /home/app \
        --shell /usr/sbin/nologin \
        app \
    && mkdir -p \
        /app \
        /models \
        /home/app/.cache/huggingface \
    && chown -R "${APP_UID}:${APP_GID}" \
        /app \
        /models \
        /home/app

WORKDIR /app

COPY downloader-requirements.txt /app/downloader-requirements.txt

RUN python -m pip install \
        --require-hashes \
        --no-cache-dir \
        --requirement /app/downloader-requirements.txt

COPY --chown=10001:10001 \
    scripts/download_model.py \
    /app/download_model.py

USER 10001:10001

ENTRYPOINT ["python", "/app/download_model.py"]